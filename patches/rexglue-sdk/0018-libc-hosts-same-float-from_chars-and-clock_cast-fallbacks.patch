From dc55f2858e627981957bba44c989b11c99d6aecb Mon Sep 17 00:00:00 2001
From: patch <a@b.c>
Date: Thu, 22 Oct 2026 02:46:56 +0000
Subject: [PATCH] libc++ hosts: same float from_chars and clock_cast fallbacks
 as Android

---
 include/rex/chrono/chrono.h  | 4 ++--
 include/rex/string/numeric.h | 8 ++++----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/include/rex/chrono/chrono.h b/include/rex/chrono/chrono.h
index 6f4b3f0..184b7ad 100644
--- a/include/rex/chrono/chrono.h
+++ b/include/rex/chrono/chrono.h
@@ -116,8 +116,8 @@ using XSystemClock = detail::NtSystemClock<detail::Domain::Guest>;
 
 namespace std::chrono {
 
-#if defined(__APPLE__) || defined(__ANDROID__)
-// Apple libc++ and the NDK libc++ do not expose clock_time_conversion or clock_cast.
+#if defined(__APPLE__) || defined(__ANDROID__) || defined(_LIBCPP_VERSION)
+// libc++ (Apple, NDK, and Linux hosts with libc++ 18) does not expose clock_time_conversion or clock_cast.
 template <class, class>
 struct clock_time_conversion {};
 
diff --git a/include/rex/string/numeric.h b/include/rex/string/numeric.h
index 13dffd7..8f92baa 100644
--- a/include/rex/string/numeric.h
+++ b/include/rex/string/numeric.h
@@ -26,7 +26,7 @@
 #include <rex/string/utf8.h>
 #include <rex/vec128.h>
 
-#if REX_PLATFORM_MAC || defined(__ANDROID__)
+#if REX_PLATFORM_MAC || defined(__ANDROID__) || defined(_LIBCPP_VERSION)
 #include <locale.h>
 #endif
 
@@ -114,7 +114,7 @@ inline T ifs(const std::string_view value, bool force_hex) {
   return result;
 }
 
-#if REX_PLATFORM_MAC || defined(__ANDROID__)
+#if REX_PLATFORM_MAC || defined(__ANDROID__) || defined(_LIBCPP_VERSION)
 template <typename T>
 inline std::from_chars_result portable_float_from_chars(const char* first, const char* last,
                                                         T& value) {
@@ -189,7 +189,7 @@ inline T fpfs(const std::string_view value, bool force_hex) {
     }
     std::memcpy(&result, &pun, sizeof(PUN));
   } else {
-#if REX_PLATFORM_MAC || defined(__ANDROID__)
+#if REX_PLATFORM_MAC || defined(__ANDROID__) || defined(_LIBCPP_VERSION)
     auto [p, error] = portable_float_from_chars(range.data(), range.data() + range.size(), result);
 #else
     auto [p, error] = std::from_chars(range.data(), range.data() + range.size(), result,
@@ -316,7 +316,7 @@ inline vec128_t from_string<vec128_t>(const std::string_view value, bool force_h
         assert_always();
         return vec128_t();
       }
-#if REX_PLATFORM_MAC || defined(__ANDROID__)
+#if REX_PLATFORM_MAC || defined(__ANDROID__) || defined(_LIBCPP_VERSION)
       auto result = detail::portable_float_from_chars(p, end, v.f32[i]);
 #else
       auto result = std::from_chars(p, end, v.f32[i], std::chars_format::general);
-- 
2.43.0

